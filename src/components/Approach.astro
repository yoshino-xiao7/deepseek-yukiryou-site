---
/**
 * 设计理念区（对齐 Harness 官网 "Design approach"）：
 * 编号条目 + 分隔线。本区不放真实产品截图。
 */
import type { Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const a = dict.approach;
---

<section class="section approach" id="approach">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><span>{a.eyebrow}</span></span>
      <h2 class="t-h1 section-title approach-title">{a.title}</h2>
    </div>

    <div class="approach-list reveal">
      {a.items.map((item, i) => (
        <article class="approach-item">
          <span class="t-mono-label approach-index">{String(i + 1).padStart(2, '0')}</span>
          <div class="approach-copy">
            <h3 class="t-subtitle approach-item-title">{item.title}</h3>
            <p class="t-body text-muted approach-desc">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .approach-title {
    max-width: 680px;
    margin-bottom: 0;
  }

  .approach-list {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-9);
  }

  .approach-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-7);
    border-top: 1px solid var(--border-subtle);
  }

  .approach-item:first-child {
    padding-top: 0;
    border-top: 0;
  }

  .approach-item:last-child {
    padding-bottom: 0;
  }

  .approach-index {
    display: block;
    padding-top: 6px;
  }

  .approach-copy {
    max-width: 720px;
  }

  .approach-item-title {
    font-size: 22px;
    font-weight: 400;
    margin-bottom: var(--space-3);
  }

  .approach-desc {
    line-height: 1.7;
  }
</style>
