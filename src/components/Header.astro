---
/**
 * 顶部导航：吸顶毛玻璃，桌面端完整导航 + 语言切换 + 下载按钮；
 * 移动端折叠菜单。
 */
import Icon from './Icon.astro';
import { PROJECT, type Dict, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { lang, dict } = Astro.props;

const navItems = [
  { href: '#features', label: dict.nav.features },
  { href: '#why', label: dict.nav.why },
  { href: '#how', label: dict.nav.how },
  { href: '#install', label: dict.nav.install },
  { href: '#roadmap', label: dict.nav.roadmap },
  { href: '#security', label: dict.nav.security },
  { href: '#faq', label: dict.nav.faq },
];

const otherLang: Lang = lang === 'zh-CN' ? 'en' : 'zh-CN';
const otherHref = otherLang === 'en' ? '/en/' : '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={lang === 'zh-CN' ? '/' : '/en/'} aria-label="DeepSeek YukiRyou">
      <img class="brand-logo" src={PROJECT.icon} alt="" width="28" height="28" loading="eager" />
      <span class="brand-name">DeepSeek&nbsp;YukiRyou</span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {navItems.map((item) => (
        <a class="nav-link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="lang-switch" href={otherHref} aria-label="Switch language">
        {lang === 'zh-CN' ? 'EN' : '中文'}
      </a>
      <a class="btn btn-primary btn-sm" href={PROJECT.latest}>
        <Icon name="download" size={15} />
        {dict.nav.download}
      </a>
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
        data-nav-toggle
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
    <nav class="mobile-nav" aria-label="Mobile">
      {navItems.map((item) => (
        <a class="mobile-link" href={item.href} data-mobile-link>{item.label}</a>
      ))}
    </nav>
    <div class="mobile-foot">
      <a class="btn btn-primary btn-block" href={PROJECT.latest}>
        <Icon name="download" size={15} />
        {dict.nav.download}
      </a>
      <a class="lang-switch" href={otherHref}>{lang === 'zh-CN' ? 'EN' : '中文'}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(5, 7, 11, 0.72);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 20px;
    height: var(--nav-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }

  .brand-logo {
    border-radius: 7px;
  }

  .brand-name {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 4px;
    margin-inline: auto;
  }

  .nav-link {
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-muted);
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-link:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .lang-switch {
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-muted);
    border: 1px solid var(--border);
    transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .lang-switch:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: rgba(255, 255, 255, 0.04);
  }

  .btn-sm {
    padding: 8px 18px;
    font-size: 14px;
  }

  .nav-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .nav-toggle:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .mobile-menu {
    padding: 8px 24px 20px;
    border-bottom: 1px solid var(--border);
    background: rgba(5, 7, 11, 0.96);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding-block: 8px;
  }

  .mobile-link {
    padding: 12px 4px;
    font-size: 16px;
    color: var(--text);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-foot {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
  }

  .btn-block {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
    }
    .nav-toggle,
    .mobile-menu {
      display: none;
    }
    .header-actions {
      margin-left: 0;
    }
  }
</style>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      menu.hidden = open;
    });
    menu.querySelectorAll('[data-mobile-link]').forEach((a) =>
      a.addEventListener('click', () => {
        menu.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      })
    );
  }
</script>
