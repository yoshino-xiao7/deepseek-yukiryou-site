---
/**
 * 工作原理：运行时链路（等宽节点卡）+ 安全要点
 */
import Icon from './Icon.astro';
import { type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="section" id="how">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow"><span>{dict.how.eyebrow}</span></span>
      <h2 class="t-h1">{dict.how.title}</h2>
      <p class="t-body section-sub">{dict.how.subtitle}</p>
    </div>

    <ol class="flow reveal">
      {dict.how.steps.map((step, i) => (
        <li class="flow-step">
          <span class="t-mono-label flow-index">{String(i + 1).padStart(2, '0')}</span>
          <div class="flow-body">
            <h3 class="flow-title">{step.title}</h3>
            <p class="t-caption text-muted flow-desc">{step.desc}</p>
          </div>
        </li>
      ))}
    </ol>

    <ul class="flow-notes reveal">
      {dict.how.notes.map((n) => (
        <li class="flow-note">
          <Icon name="lock" size={14} />
          <span class="t-caption">{n}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .flow {
    list-style: none;
    margin: var(--space-8) 0 var(--space-6);
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .flow {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .flow-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--surface-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    padding: var(--space-5);
    transition: border-color 0.3s ease;
  }

  .flow-step:hover {
    border-color: var(--border-hover);
  }

  .flow-index {
    color: var(--brand);
  }

  .flow-title {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
    word-break: break-word;
  }

  .flow-desc {
    line-height: 1.6;
  }

  .flow-notes {
    list-style: none;
    margin: 0;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .flow-notes {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-3) var(--space-6);
    }
  }

  .flow-note {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--text-muted);
  }

  .flow-note :global(svg) {
    color: var(--green);
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
