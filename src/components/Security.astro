---
/**
 * 安全与隐私：卡片网格
 */
import Icon from './Icon.astro';
import { type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="section" id="security">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><span>{dict.security.eyebrow}</span></span>
      <h2 class="t-h1 section-title">{dict.security.title}</h2>
      <p class="t-body section-sub">{dict.security.subtitle}</p>
    </div>

    <div class="security-grid reveal">
      {dict.security.items.map((item) => (
        <article class="card security-card">
          <div class="security-icon">
            <Icon name={item.icon} size={22} strokeWidth={1.5} />
          </div>
          <h3 class="t-title security-title">{item.title}</h3>
          <p class="t-caption text-muted security-desc">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .security-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: 1fr;
    margin-top: var(--space-8);
  }

  @media (min-width: 640px) {
    .security-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .security-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }

  .security-card {
    display: flex;
    flex-direction: column;
  }

  .security-icon {
    color: var(--text);
    opacity: 0.7;
    margin-bottom: var(--space-4);
  }

  .security-title {
    margin-bottom: var(--space-2);
  }

  .security-desc {
    line-height: 1.65;
  }
</style>
