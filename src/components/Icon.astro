  {name === 'phone' && (
    <>
      <rect width="14" height="20" x="5" y="2" rx="2" ry="2" />
      <path d="M12 18h.01" />
    </>
  )}

  {name === 'plugin' && (
    <>
      <path d="M12 22v-3m0-6v-3m0-3V2" />
      <path d="M8 4h8" />
      <path d="M8 7h8" />
      <path d="M4 10h16" />
      <path d="M4 13h16" />
