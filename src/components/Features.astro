---
/**
 * 功能特性：8 张卡片网格
 */
import Icon from './Icon.astro';
import { type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="section" id="features">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow">{dict.features.eyebrow}</span>
      <h2 class="section-title">{dict.features.title}</h2>
      <p class="section-sub">{dict.features.subtitle}</p>
    </div>

    <div class="feature-grid">
      {dict.features.items.map((item, i) => (
        <article class="feature-card reveal" style={`--d: ${i * 40}ms`}>
          <span class="feature-icon">
            <Icon name={item.icon} size={22} />
          </span>
          <h3 class="feature-title">{item.title}</h3>
          <p class="feature-desc">{item.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .feature-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .feature-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .feature-card {
    background: linear-gradient(180deg, var(--bg-card), rgba(11, 16, 24, 0.6));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 22px;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      background 0.2s ease;
    transition-delay: var(--d, 0ms);
  }

  .feature-card:hover {
    border-color: var(--accent-border);
    background: linear-gradient(180deg, #0e1524, rgba(11, 16, 24, 0.7));
    transform: translateY(-3px);
  }

  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent-hover);
    margin-bottom: 16px;
  }

  .feature-title {
    font-size: 17px;
    font-weight: 650;
    margin-bottom: 8px;
  }

  .feature-desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
  }
</style>
