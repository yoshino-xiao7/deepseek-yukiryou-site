---
/**
 * 为什么选择：三个价值点 + 对比表格（高亮 YukiRyou 列）
 */
import Icon from './Icon.astro';
import { type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const { compare } = dict.why;
---

<section class="section" id="why">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><span>{dict.why.eyebrow}</span></span>
      <h2 class="t-h1 section-title">{dict.why.title}</h2>
      <p class="t-body section-sub">{dict.why.subtitle}</p>
    </div>

    <div class="grid-3 why-points reveal">
      {dict.why.points.map((p) => (
        <article class="card why-card">
          <div class="why-icon">
            <Icon name={p.icon} size={22} strokeWidth={1.5} />
          </div>
          <h3 class="t-title why-title">{p.title}</h3>
          <p class="t-caption text-muted why-desc">{p.desc}</p>
        </article>
      ))}
    </div>

    <h3 class="t-subtitle compare-title reveal">{dict.why.compareTitle}</h3>

    <div class="table-wrap reveal">
      <table class="compare-table">
        <thead>
          <tr>
            {compare.header.map((h, i) => (
              <th class:list={{ 'col-highlight': i === compare.highlight }}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compare.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td class:list={{ 'cell-label': i === 0, 'col-highlight': i === compare.highlight }}>
                  {i === compare.highlight && <Icon name="check" size={14} />}
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .why-points {
    margin-bottom: var(--space-9);
  }

  .why-card {
    display: flex;
    flex-direction: column;
  }

  .why-icon {
    color: var(--text);
    opacity: 0.7;
    margin-bottom: var(--space-4);
  }

  .why-title {
    margin-bottom: var(--space-2);
  }

  .why-desc {
    line-height: 1.65;
  }

  .compare-title {
    margin-bottom: var(--space-5);
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    background: var(--surface-3);
  }

  .compare-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .compare-table th,
  .compare-table td {
    padding: var(--space-4) var(--space-5);
    text-align: left;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
    color: var(--text-muted);
  }

  .compare-table thead th {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    background: var(--surface-4);
  }

  .compare-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .compare-table td.cell-label {
    color: var(--text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  .compare-table .col-highlight {
    background: rgba(var(--rgb-brand), 0.1);
    color: var(--text);
  }

  .compare-table thead .col-highlight {
    background: rgba(var(--rgb-brand), 0.18);
    color: var(--text);
  }

  .compare-table .col-highlight :global(svg) {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 6px;
    color: var(--green);
  }
</style>
