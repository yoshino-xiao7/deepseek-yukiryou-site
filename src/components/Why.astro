---
/**
 * 为什么选择：三个价值点 + 对比表格（高亮 YukiRyou 列）
 */
import Icon from './Icon.astro';
import { type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const { compare } = dict.why;
---

<section class="section" id="why">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">{dict.why.eyebrow}</span>
      <h2 class="section-title">{dict.why.title}</h2>
      <p class="section-sub">{dict.why.subtitle}</p>
    </div>

    <div class="why-points">
      {dict.why.points.map((p, i) => (
        <article class="why-card reveal" style={`--d: ${i * 60}ms`}>
          <span class="why-icon">
            <Icon name={p.icon} size={20} />
          </span>
          <h3 class="why-title">{p.title}</h3>
          <p class="why-desc">{p.desc}</p>
        </article>
      ))}
    </div>

    <h3 class="compare-title reveal">{dict.why.compareTitle}</h3>

    <div class="table-wrap reveal">
      <table class="compare-table">
        <thead>
          <tr>
            {compare.header.map((h, i) => (
              <th class:list={{ 'col-highlight': i === compare.highlight }}>{h}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {compare.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td class:list={{ 'cell-label': i === 0, 'col-highlight': i === compare.highlight }}>
                  {i === compare.highlight && <Icon name="check" size={14} />}
                  {cell}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .why-points {
    display: grid;
    gap: 16px;
    grid-template-columns: 1fr;
    margin-bottom: 64px;
  }

  @media (min-width: 768px) {
    .why-points {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .why-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 26px 24px;
  }

  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    color: var(--accent-hover);
    margin-bottom: 16px;
  }

  .why-title {
    font-size: 18px;
    font-weight: 650;
    margin-bottom: 8px;
  }

  .why-desc {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .compare-title {
    font-size: 20px;
    font-weight: 650;
    margin-bottom: 20px;
  }

  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }

  .compare-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 14px;
  }

  .compare-table th,
  .compare-table td {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .compare-table thead th {
    font-weight: 650;
    color: var(--text);
    background: rgba(255, 255, 255, 0.025);
    font-size: 13.5px;
  }

  .compare-table tbody tr:last-child td {
    border-bottom: none;
  }

  .compare-table td.cell-label {
    color: var(--text-muted);
    font-weight: 600;
    white-space: nowrap;
  }

  .compare-table td,
  .compare-table th {
    color: var(--text-muted);
  }

  .compare-table .col-highlight {
    background: var(--accent-soft);
    color: var(--text) !important;
  }

  .compare-table .col-highlight :global(svg) {
    display: inline-block;
    vertical-align: -2px;
    margin-right: 6px;
    color: var(--green);
  }

  .compare-table thead .col-highlight {
    background: rgba(77, 107, 254, 0.22);
  }
</style>
