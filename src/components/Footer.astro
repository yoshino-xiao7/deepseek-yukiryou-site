---
/**
 * 页脚：品牌 + 导航 + 项目链接 + 免责声明
 */
import Icon from './Icon.astro';
import { PROJECT, type Dict, type Lang } from '../i18n/content';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { lang, dict } = Astro.props;

const siteLinks = [
  { href: '#features', label: dict.nav.features },
  { href: '#why', label: dict.nav.why },
  { href: '#install', label: dict.nav.install },
  { href: '#roadmap', label: dict.nav.roadmap },
  { href: '#faq', label: dict.nav.faq },
];

const projectLinks = [
  { href: PROJECT.repo, label: 'GitHub' },
  { href: PROJECT.releases, label: 'Releases' },
  { href: PROJECT.issues, label: 'Issues' },
  { href: PROJECT.license, label: 'MIT License' },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={lang === 'zh-CN' ? '/' : '/en/'} aria-label="DeepSeek YukiRyou">
          <img class="brand-logo" src={PROJECT.icon} alt="" width="32" height="32" loading="lazy" />
          <span class="brand-name">DeepSeek&nbsp;YukiRyou</span>
        </a>
        <p class="footer-tagline">{dict.footer.tagline}</p>
        <a class="btn btn-secondary btn-sm" href={PROJECT.repo}>
          <Icon name="github" size={15} />
          GitHub
        </a>
      </div>

      <nav class="footer-col" aria-label="Footer site">
        <h4 class="footer-heading">{dict.footer.navTitle}</h4>
        <ul class="footer-links">
          {siteLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer-col" aria-label="Footer project">
        <h4 class="footer-heading">{dict.footer.projectLinks}</h4>
        <ul class="footer-links">
          {projectLinks.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="footer-disclaimer">
        <Icon name="shield" size={13} />
        {dict.footer.disclaimer}
      </p>
      <div class="footer-meta">
        <span>{dict.footer.license}</span>
        <span class="dot-sep" aria-hidden="true"></span>
        <span>{dict.footer.copyright}</span>
      </div>
    </div>

    <!-- 备案信息（中国大陆合规要求，中英文页脚均展示） -->
    <div class="beian-row">
      <a
        class="beian-link"
        href="https://beian.miit.gov.cn/"
        target="_blank"
        rel="noopener noreferrer"
      >
        湘ICP备2025149178号-1
      </a>
      <span class="dot-sep" aria-hidden="true"></span>
      <a
        class="beian-link"
        href="http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=43102302000181"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="beian-badge" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path
            d="M12 2.5 4.5 5.4v5.2c0 4.6 3.1 8.6 7.5 10 4.4-1.4 7.5-5.4 7.5-10V5.4L12 2.5z"
            fill="currentColor"
            opacity="0.9"
          />
          <path
            d="M12 6.2l1.4 3.1 3.4.4-2.5 2.3.7 3.4-3-1.7-3 1.7.7-3.4-2.5-2.3 3.4-.4L12 6.2z"
            fill="#05070b"
          />
        </svg>
        湘公网安备43102302000181号
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: rgba(5, 7, 11, 0.6);
    padding-block: 56px 32px;
  }

  .footer-grid {
    display: grid;
    gap: 36px;
    grid-template-columns: 1fr;
    margin-bottom: 48px;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .brand-logo {
    border-radius: 8px;
  }

  .brand-name {
    font-size: 17px;
    font-weight: 700;
  }

  .footer-tagline {
    font-size: 14px;
    color: var(--text-muted);
    margin-bottom: 20px;
    max-width: 30em;
  }

  .btn-sm {
    padding: 8px 18px;
    font-size: 14px;
  }

  .footer-heading {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 16px;
  }

  .footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links a {
    font-size: 14.5px;
    color: var(--text-muted);
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--text);
  }

  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--text-faint);
    max-width: 46em;
  }

  .footer-disclaimer :global(svg) {
    color: var(--text-faint);
    flex-shrink: 0;
    margin-top: 3px;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .dot-sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--text-faint);
  }

  /* 备案信息 */
  .beian-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .beian-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    color: var(--text-faint);
    transition: color 0.15s ease;
  }

  .beian-link:hover {
    color: var(--text-muted);
  }

  .beian-badge {
    color: var(--text-faint);
    flex-shrink: 0;
  }
</style>
