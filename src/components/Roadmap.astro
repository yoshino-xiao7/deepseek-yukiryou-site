---
/**
 * 路线图：开发中 / 规划中
 */
import Icon from './Icon.astro';
import { type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;

const statusIcon: Record<string, string> = {
  dev: 'spark',
  planned: 'list',
  paused: 'pause',
};
---

<section class="section" id="roadmap">
  <div class="container">
    <div class="section-head section-head--center reveal">
      <span class="eyebrow"><span>{dict.roadmap.eyebrow}</span></span>
      <h2 class="t-h1">{dict.roadmap.title}</h2>
      <p class="t-body section-sub">{dict.roadmap.subtitle}</p>
    </div>

    <div class="roadmap-grid">
      {dict.roadmap.items.map((item) => (
        <article class="roadmap-card reveal">
          <span class:list={['roadmap-status', `status-${item.status}`]}>
            <Icon name={statusIcon[item.status]} size={12} />
            {item.statusLabel}
          </span>
          <h3 class="t-subtitle roadmap-title">{item.title}</h3>
          <p class="t-caption text-muted roadmap-desc">{item.desc}</p>
        </article>
      ))}
    </div>

    <p class="t-caption roadmap-note reveal">
      <Icon name="shield" size={14} />
      {dict.roadmap.note}
    </p>
  </div>
</section>

<style>
  .roadmap-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr;
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .roadmap-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .roadmap-card {
    background: var(--surface-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: border-color 0.3s ease;
  }

  .roadmap-card:hover {
    border-color: var(--border-hover);
  }

  .roadmap-status {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    border-radius: var(--radius-pill);
    padding: 5px 11px;
  }

  .status-dev {
    color: var(--amber);
    background: rgba(254, 188, 46, 0.1);
    border: 1px solid rgba(254, 188, 46, 0.3);
  }

  .status-planned {
    color: var(--text-muted);
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
  }

  .status-paused {
    color: var(--text-faint);
    background: var(--surface-3);
    border: 1px dashed var(--border-strong);
  }

  .roadmap-desc {
    line-height: 1.65;
  }

  .roadmap-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-6);
    color: var(--text-faint);
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
    justify-content: center;
  }

  .roadmap-note :global(svg) {
    color: var(--brand);
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
