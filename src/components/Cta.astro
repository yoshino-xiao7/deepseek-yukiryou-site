---
/**
 * 底部 CTA：居中大标题 + 按钮组（对齐 Harness 官网收尾区）
 */
import Icon from './Icon.astro';
import Download from './Download.astro';
import { PROJECT, type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="cta">
  <div class="container cta-inner reveal">
    <h2 class="t-h1 cta-title">{dict.cta.title}</h2>
    <p class="t-body text-muted cta-sub">{dict.cta.subtitle}</p>

    <div class="cta-actions">
      <Download dict={dict} variant="lg" />
      <a class="btn btn-secondary btn-m" href={PROJECT.repo}>
        <Icon name="star" size={16} />
        {dict.cta.star}
      </a>
      <a class="btn btn-ghost btn-m" href={PROJECT.issues}>
        <Icon name="external" size={15} />
        {dict.cta.feedback}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }

  /* 顶部品牌辉光，呼应官网收尾区的柔光背景 */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      58% 62% at 50% 100%,
      rgba(var(--rgb-brand), 0.16),
      transparent 72%
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-top: var(--space-11);
    padding-bottom: var(--space-13);
  }

  .cta-title {
    max-width: 600px;
  }

  .cta-sub {
    max-width: 652px;
    margin-top: var(--space-5);
    line-height: 1.7;
  }

  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: var(--space-7);
  }
</style>
