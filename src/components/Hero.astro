---
/**
 * Hero 区：徽章 + 主标题 + 副标题 + 按钮 + 需求列表 + 应用截图
 */
import Icon from './Icon.astro';
import Download from './Download.astro';
import { PROJECT, type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy reveal">
      <span class="hero-badge">
        <span class="hero-badge-dot"></span>
        {dict.hero.badge}
        <span class="hero-badge-sep"></span>
        {dict.hero.versionLabel} <span data-dl-version>{PROJECT.version}</span>
      </span>

      <h1 class="hero-title">
        {dict.hero.title}
        <br />
        <span class="gradient-text">{dict.hero.titleAccent}</span>
      </h1>

      <p class="hero-sub">{dict.hero.subtitle}</p>

      <div class="hero-cta">
        <Download dict={dict} variant="lg" />
        <a class="btn btn-secondary btn-lg" href={PROJECT.repo}>
          <Icon name="github" size={17} />
          {dict.hero.ctaSecondary}
        </a>
      </div>

      <p class="hero-disclaimer">
        <Icon name="shield" size={13} />
        {dict.hero.disclaimer}
      </p>

      <ul class="hero-req">
        {dict.hero.requirements.map((r) => (
          <li>
            <Icon name="check" size={13} />
            {r}
          </li>
        ))}
      </ul>
    </div>

    <div class="hero-visual reveal">
      <figure class="shot-frame">
        <img
          class="shot-img"
          src="/app-screenshot.png"
          alt={dict.hero.shotAlt}
          width="1400"
          height="789"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      <p class="hero-visual-caption">
        <Icon name="spark" size={13} />
        {dict.hero.shotCaption}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: 72px 64px;
  }

  .hero-inner {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: 96px 80px;
    }
    .hero-inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: 56px;
    }
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 7px 14px;
    margin-bottom: 22px;
  }

  .hero-badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 10px rgba(52, 211, 153, 0.9);
  }

  .hero-badge-sep {
    width: 1px;
    height: 12px;
    background: var(--border-strong);
  }

  .hero-title {
    font-size: clamp(32px, 5.4vw, 54px);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: 20px;
  }

  .hero-sub {
    font-size: 17.5px;
    line-height: 1.75;
    color: var(--text-muted);
    max-width: 34em;
    margin-bottom: 30px;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 22px;
  }

  .btn-lg {
    padding: 13px 26px;
    font-size: 16px;
  }

  .hero-disclaimer {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: var(--text-faint);
    margin-bottom: 16px;
  }

  .hero-req {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .hero-req li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .hero-req li :global(svg) {
    color: var(--green);
  }

  .hero-visual {
    position: relative;
  }

  /* 真实应用截图的外框 */
  .shot-frame {
    margin: 0;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-strong);
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.03),
      0 24px 64px -24px rgba(0, 0, 0, 0.8),
      0 0 80px -20px rgba(77, 107, 254, 0.28);
  }

  .shot-img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-visual-caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-faint);
    margin-top: 18px;
  }

  .hero-visual-caption :global(svg) {
    color: var(--accent-hover);
  }
</style>
