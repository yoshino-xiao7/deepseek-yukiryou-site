---
/**
 * Hero 区：对齐 DeepSeek Harness 官网版式 —
 * 左侧 kicker + 大标题 + 两段副文案 + 按钮组，
 * 右侧带 Tab 的终端卡片（交通灯 + 复制按钮）。
 */
import Icon from './Icon.astro';
import Download from './Download.astro';
import { PROJECT, DOWNLOADS, type Dict } from '../i18n/content';
import { CHECKSUM_TARGETS, formatChecksumDemo } from '../lib/checksum-demo';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const term = dict.hero.terminal;

/**
 * 终端演示只使用真实数据：构建时取下载清单里的文件名与 SHA-256，
 * 客户端在 /api/downloads 返回更新后的版本时按同一函数重写，
 * 避免版本更新后仍显示旧版哈希。
 */
const termBlocks = CHECKSUM_TARGETS.map((target) => {
  const artifact = DOWNLOADS.platforms?.[target.platform]?.[target.kind];
  return {
    ...target,
    ...formatChecksumDemo(target.mode, artifact?.name, artifact?.sha256, target.fallbackName),
  };
});
---

<section class="hero">
  <canvas class="hero-canvas" data-hero-fluid aria-hidden="true"></canvas>
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-enter hero-head" style="--enter-y:24px;--enter-blur:10px;animation-duration:0.9s">
        <p class="hero-kicker">{dict.hero.kicker}</p>
        <h1 class="t-hero hero-title">
          {dict.hero.title}
          <br />
          <span class="hero-title-accent">{dict.hero.titleAccent}</span>
        </h1>
      </div>

      <div class="hero-enter hero-lede" style="--enter-y:20px;--enter-blur:8px;animation-delay:0.15s">
        <p class="t-body text-muted">{dict.hero.subtitle}</p>
        <p class="t-body text-muted">{dict.hero.subtitle2}</p>
      </div>

      <div class="hero-enter hero-cta" style="--enter-y:16px;animation-duration:0.7s;animation-delay:0.3s">
        <Download dict={dict} variant="lg" />
        <a class="btn btn-ghost btn-m" href={PROJECT.repo}>
          <Icon name="github" size={16} />
          {dict.hero.ctaSecondary}
        </a>
      </div>

      <div class="hero-enter hero-meta" style="--enter-y:12px;animation-delay:0.42s">
        <span class="hero-version">
          <span class="hero-version-dot"></span>
          {dict.hero.versionLabel}
          <span class="hero-version-num" data-dl-version>{DOWNLOADS.version ?? PROJECT.version}</span>
        </span>
        <ul class="hero-req">
          {dict.hero.requirements.map((r) => (
            <li>{r}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hero-visual hero-enter" style="--enter-y:20px;animation-duration:0.9s;animation-delay:0.4s">
      <div class="term-tabs" role="tablist">
        {term.tabs.map((label, i) => (
          <button
            type="button"
            role="tab"
            class:list={['term-tab', i === 0 && 'is-active']}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-term-tab={i}
          >
            {label}
          </button>
        ))}
      </div>

      <div class="term-card">
        <div class="term-head">
          <div class="term-lights" aria-hidden="true">
            <span class="term-light term-light--red"></span>
            <span class="term-light term-light--amber"></span>
            <span class="term-light term-light--green"></span>
          </div>
          <button type="button" class="term-copy" data-term-copy data-copied={term.copied}>
            <Icon name="copy" size={13} />
            <span data-term-copy-label>{term.copy}</span>
          </button>
        </div>

        <div class="term-body">
          {termBlocks.map((block, i) => (
            <pre
              class:list={['term-pre', i !== 0 && 'is-hidden']}
              data-term-pre={i}
              aria-hidden={i !== 0 ? 'true' : undefined}
              data-term-platform={block.platform}
              data-term-kind={block.kind}
              data-term-mode={block.mode}
              data-term-fallback={block.fallbackName}
            ><span class="term-prompt" data-term-prompt>{block.prompt}</span><span data-term-cmd>{block.cmd}</span><span class="term-out" data-term-out>{block.outText}</span></pre>
          ))}
        </div>
      </div>

      <p class="hero-disclaimer">
        <Icon name="shield" size={13} />
        {dict.hero.disclaimer}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }

  /* 首屏背景：深蓝流体 + 半调点阵（对齐 harness 官网的 canvas 氛围层） */
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* 桌面首屏铺满视口，避免标题下方留大片空带 */
  @media (min-width: 900px) {
    .hero {
      min-height: 100svh;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
    align-items: center;
    padding-top: var(--space-10);
    padding-bottom: var(--space-9);
  }

  @media (min-width: 900px) {
    .hero-inner {
      /* minmax(0,…) 防止终端里的长等宽命令把栅格撑破 */
      grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
      padding-bottom: var(--space-11);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .hero-copy {
      gap: var(--space-7);
    }
  }

  .hero-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .hero-kicker {
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #fff;
    padding-left: 3px;
  }

  @media (min-width: 768px) {
    .hero-kicker {
      font-size: 18px;
    }
  }

  .hero-title {
    letter-spacing: 0.2px;
  }

  /* 官网大标题为纯白，品牌蓝只留给 prompt、链接与小标签 */
  .hero-title-accent {
    color: var(--text);
  }

  .hero-lede {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .hero-version {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .hero-version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(40, 200, 64, 0.8);
  }

  .hero-version-num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
  }

  .hero-req {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--space-4);
  }

  .hero-req li {
    font-size: 13px;
    color: var(--text-faint);
  }

  .hero-req li + li::before {
    content: '·';
    margin-right: var(--space-4);
    color: var(--text-faint);
  }

  /* 窄屏换行时行首不悬挂分隔点 */
  @media (max-width: 640px) {
    .hero-req li + li::before {
      content: none;
    }
  }

  /* 右侧视觉 */
  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* 终端 Tab（贴在卡片上沿） */
  .term-tabs {
    display: flex;
    gap: var(--space-1);
    padding-inline: var(--space-1);
    margin-left: 6px;
  }

  .term-tab {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .term-tab:hover {
    color: var(--text);
  }

  .term-tab.is-active {
    color: var(--text);
    background: rgba(0, 0, 0, 0.2);
    border-color: var(--border-subtle);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .term-card {
    border-radius: var(--radius-media);
    border: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow: hidden;
    margin-top: -13px;
  }

  .term-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .term-lights {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .term-light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }

  .term-light--red {
    background: var(--red);
  }
  .term-light--amber {
    background: var(--amber);
  }
  .term-light--green {
    background: var(--green);
  }

  .term-copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .term-copy:hover {
    color: var(--text);
  }

  .term-body {
    padding: var(--space-5);
    /* 两条命令叠在同一网格单元：高度由最长者决定，切 Tab 不跳动 */
    display: grid;
  }

  .term-pre {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text);
    /* 只在空格处换行。break-all 会把 SHA-256 / 长文件名从中间截开 */
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .term-pre.is-hidden {
    visibility: hidden;
  }

  .term-prompt {
    user-select: none;
    color: var(--brand);
  }

  .term-out {
    color: var(--text-muted);
  }

  .hero-disclaimer {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-faint);
  }
</style>

<script>
  // 终端 Tab 切换：同步命令文本与复制目标
  const tabs = Array.from(document.querySelectorAll('[data-term-tab]'));
  const pres = Array.from(document.querySelectorAll('[data-term-pre]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const idx = tab.getAttribute('data-term-tab');
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      pres.forEach((p) => {
        const hidden = p.getAttribute('data-term-pre') !== idx;
        p.classList.toggle('is-hidden', hidden);
        // visibility:hidden 仍留在无障碍树内，显式标记避免读屏念到未选中的命令
        if (hidden) p.setAttribute('aria-hidden', 'true');
        else p.removeAttribute('aria-hidden');
      });
    });
  });

  // 复制当前可见命令
  const copyBtn = document.querySelector('[data-term-copy]');
  const copyLabel = document.querySelector('[data-term-copy-label]');
  copyBtn?.addEventListener('click', async () => {
    const visible = pres.find((p) => !p.classList.contains('is-hidden'));
    // 只复制命令本身，不含模拟输出
    const text = visible?.querySelector('[data-term-cmd]')?.textContent?.trim() ?? '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      return;
    }
    if (!copyLabel) return;
    const original = copyLabel.textContent;
    copyLabel.textContent = copyBtn.getAttribute('data-copied') ?? 'Copied';
    setTimeout(() => {
      copyLabel.textContent = original;
    }, 1600);
  });

  /**
   * 首屏背景 = 两层 canvas：
   * 1) data-hero-fluid —— WebGL flowmap 流体。可调参数取自 harness 官网流体层：
   *    五段色带 黑→#1A3870→#204a7e→#eed8aa→黑、光晕 #fff7d1/#538dca/#2d448b、
   *    swirl 12 次迭代、scale 1.77、speed 0.28、vignette 0.38、grain 0.005；
   *    鼠标把速度“刷”进流场纹理（半径 0.09、强度 1.8、衰减 0.925），渲染时
   *    流体 UV 被流场扭曲，即官网“划动搅动流体”的效果；光晕横向跟随鼠标
   *    （lightFollow 0.63）。WebGL 不可用时同画布回退 2D 丝带绘制。
   * 2) data-hero-canvas —— 交互点阵网格（官方同款物理，透明底）。
   * 两层共用一条 30fps 主循环，滚出视口暂停；prefers-reduced-motion 画静帧。
   */
  const fluidCanvas = document.querySelector<HTMLCanvasElement>('[data-hero-fluid]');
  const gridCanvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const heroSection = fluidCanvas?.parentElement ?? null;

  if (fluidCanvas && gridCanvas && heroSection) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 触屏没有悬停，官方同款判断：这类设备不驱动鼠标交互
    const coarsePointer = window.matchMedia('(hover: none), (pointer: coarse)').matches;

    let w = 0;
    let h = 0;
    let dpr = 1;
    let visible = true;
    let pointerIn = false;
    // 归一化鼠标（y 向上）+ 官方同款平滑/速度链
    let mx = 0.5;
    let my = 0.5;
    let smx = 0.5;
    let smy = 0.5;
    let svx = 0;
    let svy = 0;
    // 光晕位置：追鼠标（平滑收敛），鼠标离开后缓缓回到默认位
    let lx = 0.89;
    let ly = 0.46;
    // 点阵用像素坐标（相对首屏）
    let gmx = NaN;
    let gmy = NaN;

    if (!reduced && !coarsePointer) {
      window.addEventListener(
        'mousemove',
        (e) => {
          const rect = heroSection.getBoundingClientRect();
          const inside =
            e.clientX >= rect.left &&
            e.clientX <= rect.right &&
            e.clientY >= rect.top &&
            e.clientY <= rect.bottom;
          pointerIn = inside;
          if (!inside) {
            gmx = NaN;
            gmy = NaN;
            return;
          }
          const px = e.clientX - rect.left;
          const py = e.clientY - rect.top;
          mx = px / rect.width;
          my = 1 - py / rect.height;
          gmx = px;
          gmy = py;
        },
        { passive: true }
      );
    }

    /* ========== 层 1：流体 ========== */

    const VS = `attribute vec2 aPos;
varying vec2 vUv;
void main(){ vUv = aPos * 0.5 + 0.5; gl_Position = vec4(aPos, 0.0, 1.0); }`;

    // 流场纹理 ping-pong：把鼠标速度以高斯笔刷注入，乘衰减向中性值回落
    const SPLAT_FS = `precision highp float;
varying vec2 vUv;
uniform sampler2D uPrev;
uniform vec2 uMouse;
uniform vec2 uVel;
uniform float uRadius;
uniform float uStrength;
uniform float uDecay;
uniform float uAspect;
void main(){
  vec2 f = texture2D(uPrev, vUv).xy * 2.0 - 1.0;
  f *= uDecay;
  vec2 d = vUv - uMouse;
  d.x *= uAspect;
  float g = exp(-dot(d, d) / (uRadius * uRadius));
  f += uVel * g * uStrength * 0.5;
  gl_FragColor = vec4(f * 0.5 + 0.5, 0.0, 1.0);
}`;

    // 渲染：swirl 迭代 + fbm 域扭曲 + 流场扰动，映到五段色带；
    // 光晕（核/晕/外圈）横向跟随鼠标；亮带泛光 + 暗角 + 颗粒 + 底部渐隐
    const RENDER_FS = `precision highp float;
varying vec2 vUv;
uniform sampler2D uFlow;
uniform vec2 uRes;
uniform float uTime;
uniform float uAspect;
uniform vec2 uLight;
uniform vec3 uC1;
uniform vec3 uC2;
uniform vec3 uC3;
uniform vec3 uC4;
uniform vec3 uC5;
uniform vec3 uG1;
uniform vec3 uG2;
uniform vec3 uG3;
float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123); }
float vnoise(vec2 p){
  vec2 i = floor(p);
  vec2 f = fract(p);
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
             mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x), u.y);
}
float fbm(vec2 p){
  float v = 0.0;
  float a = 0.5;
  for(int i = 0; i < 5; i++){
    v += a * vnoise(p);
    p = p * 2.02 + vec2(3.1, 7.7);
    a *= 0.5;
  }
  return v;
}
vec2 swirl(vec2 p, float t){
  for(int i = 0; i < 12; i++){
    float fi = float(i);
    vec2 c = vec2(0.5 + 0.38 * sin(t * 0.31 + fi * 1.7), 0.5 + 0.34 * cos(t * 0.23 + fi * 2.4));
    vec2 d = p - c;
    float fall = exp(-dot(d, d) * 1.6);
    float a = 0.32 * fall * sin(t * 0.35 + fi * 2.1);
    float ca = cos(a);
    float sa = sin(a);
    p = c + mat2(ca, -sa, sa, ca) * d;
  }
  return p;
}
vec3 pal(float t){
  t = clamp(t, 0.0, 1.0);
  vec3 c = mix(uC1, uC2, smoothstep(0.0, 0.3, t));
  c = mix(c, uC3, smoothstep(0.3, 0.55, t));
  c = mix(c, uC4, smoothstep(0.55, 0.78, t));
  c = mix(c, uC5, smoothstep(0.82, 1.0, t));
  return c;
}
void main(){
  vec2 uv = vUv;
  vec2 flow = texture2D(uFlow, uv).xy * 2.0 - 1.0;
  vec2 p = vec2(uv.x * uAspect, uv.y);
  p += vec2(-0.62, -0.24);
  p *= 1.77;
  p = swirl(p, uTime);
  float t5 = uTime * 0.05;
  p += (vec2(fbm(p * 1.4 + t5), fbm(p * 1.4 - t5 + 5.2)) - 0.5) * 0.55;
  p += flow * 0.9;
  float v = fbm(p * 0.85 + t5 * 1.3);
  vec3 col = pal(v);
  col += smoothstep(0.61, 0.79, v) * 0.22 * vec3(1.0, 0.93, 0.75);
  vec2 ld = uv - uLight;
  ld.x *= uAspect;
  float l2 = dot(ld, ld);
  col += uG1 * exp(-l2 / 0.008) * 0.5;
  col += uG2 * exp(-l2 / 0.05) * 0.16;
  col += uG3 * exp(-l2 / 0.18) * 0.13;
  vec2 q = uv - 0.5;
  col *= 1.0 - 0.38 * smoothstep(0.12, 0.58, dot(q, q));
  col = mix(col, vec3(0.039), smoothstep(0.42, -0.02, uv.y));
  col += (hash(uv * uRes + fract(uTime) * 7.0) - 0.5) * 0.006;
  gl_FragColor = vec4(col, 1.0);
}`;

    const ctx = gridCanvas.getContext('2d');

    /* ---- 交互点阵网格：物理常量与 harness 官网点阵层一致 ---- */
    interface GridDot {
      rx: number;
      ry: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
    }
    let grid: GridDot[] = [];
    let gCols = 0;
    let gRows = 0;

    const initGrid = () => {
      const gap = 90;
      gCols = Math.ceil(w / gap) + 1;
      gRows = Math.ceil(h / gap) + 1;
      const ox = (w - (gCols - 1) * gap) / 2;
      const oy = (h - (gRows - 1) * gap) / 2;
      grid = [];
      for (let r = 0; r < gRows; r++) {
        for (let c = 0; c < gCols; c++) {
          const rx = ox + gap * c;
          const ry = oy + gap * r;
          grid.push({ rx, ry, x: rx, y: ry, vx: 0, vy: 0 });
        }
      }
    };

    const drawGridFrame = () => {
      if (!ctx || grid.length === 0 || w === 0) return;
      ctx.clearRect(0, 0, w, h);
      const hasMouse = !Number.isNaN(gmx);

      for (const p of grid) {
        if (hasMouse) {
          const dx = p.x - gmx;
          const dy = p.y - gmy;
          const d = Math.hypot(dx, dy);
          if (d < 140 && d > 0.1) {
            const f = (1 - d / 140) * 3;
            p.vx += (dx / d) * f;
            p.vy += (dy / d) * f;
          }
        }
        p.vx += (p.rx - p.x) * 0.05;
        p.vy += (p.ry - p.y) * 0.05;
        p.vx *= 0.85;
        p.vy *= 0.85;
        p.x += p.vx;
        p.y += p.vy;
      }

      ctx.lineWidth = 0.5;
      // 官网点阵为深底调色（rgba(60,100,160)），本站流体更亮，改用冷蓝浅色保持对比
      ctx.strokeStyle = 'rgba(174, 198, 246, 0.12)';
      ctx.beginPath();
      const link = (a: GridDot, b: GridDot) => {
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy);
        if (d < 20 || d === 0) return;
        const ux = dx / d;
        const uy = dy / d;
        ctx.moveTo(a.x + 10 * ux, a.y + 10 * uy);
        ctx.lineTo(b.x - 10 * ux, b.y - 10 * uy);
      };
      for (let r = 0; r < gRows; r++) {
        for (let c = 0; c < gCols - 1; c++) link(grid[r * gCols + c], grid[r * gCols + c + 1]);
      }
      for (let c = 0; c < gCols; c++) {
        for (let r = 0; r < gRows - 1; r++) link(grid[r * gCols + c], grid[(r + 1) * gCols + c]);
      }
      ctx.stroke();

      ctx.fillStyle = 'rgb(174, 198, 246)';
      for (const p of grid) {
        let half = 1.8;
        let alpha = 0.28;
        if (hasMouse) {
          const l = Math.max(0, 1 - Math.hypot(p.x - gmx, p.y - gmy) / 140);
          half = 1.8 + 2 * l;
          alpha = 0.28 + 0.45 * l;
        }
        ctx.globalAlpha = alpha;
        ctx.fillRect(p.x - half, p.y - half, half * 2, half * 2);
      }
      ctx.globalAlpha = 1;
    };

    /* ---- 漂浮微粒：缓慢漂移，鼠标划过时被搅动带走 ---- */
    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      a: number;
      warm: boolean;
      ph: number;
    }
    let particles: Particle[] = [];

    const initParticles = () => {
      const count = Math.round(Math.min(220, Math.max(90, (w * h) / 8500)));
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: 0,
          vy: 0,
          r: 0.6 + Math.random() * 1.6,
          a: 0.12 + Math.random() * 0.3,
          warm: Math.random() < 0.22,
          ph: Math.random() * Math.PI * 2,
        });
      }
    };

    const drawParticlesFrame = (t: number) => {
      if (!ctx || w === 0) return;
      // 鼠标速度换算回像素/帧（svy 是 y 向上的归一化值）
      const mvx = svx * w;
      const mvy = -svy * h;
      const speed = Math.hypot(mvx, mvy);
      ctx.globalCompositeOperation = 'lighter';
      for (const p of particles) {
        // 缓慢的流场漂移，让微粒静止时也是活的
        p.vx += Math.sin(p.y * 0.006 + t * 0.4 + p.ph) * 0.012;
        p.vy += Math.cos(p.x * 0.005 - t * 0.3 + p.ph) * 0.012;
        // 搅动：光标经过时粒子沿鼠标速度被带走，并带一点切向旋涡
        if (pointerIn && speed > 0.2 && !Number.isNaN(gmx)) {
          const dx = p.x - gmx;
          const dy = p.y - gmy;
          const d = Math.hypot(dx, dy);
          if (d < 150 && d > 0.1) {
            const k = (1 - d / 150) * Math.min(speed, 24) * 0.06;
            p.vx += (mvx / speed) * k - (dy / d) * k * 0.35;
            p.vy += (mvy / speed) * k + (dx / d) * k * 0.35;
          }
        }
        p.vx *= 0.94;
        p.vy *= 0.94;
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < -8) p.x = w + 8;
        else if (p.x > w + 8) p.x = -8;
        if (p.y < -8) p.y = h + 8;
        else if (p.y > h + 8) p.y = -8;
        // 微闪烁
        const tw = 0.75 + 0.25 * Math.sin(t * 1.3 + p.ph);
        ctx.globalAlpha = p.a * tw;
        ctx.fillStyle = p.warm ? 'rgb(238, 216, 170)' : 'rgb(174, 198, 246)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    };

    /* ---- WebGL 通路 ---- */
    interface Fbo {
      tex: WebGLTexture;
      fbo: WebGLFramebuffer;
    }
    let gl: WebGLRenderingContext | null = null;
    let splat: WebGLProgram | null = null;
    let render: WebGLProgram | null = null;
    let su: Record<string, WebGLUniformLocation | null> = {};
    let ru: Record<string, WebGLUniformLocation | null> = {};
    let simA: Fbo | null = null;
    let simB: Fbo | null = null;
    let simW = 0;
    let simH = 0;

    if (fluidCanvas) {
      gl = (fluidCanvas.getContext('webgl') ??
        fluidCanvas.getContext('experimental-webgl')) as WebGLRenderingContext | null;
    }
    // WebGL 不可用：同一画布退回 2D 丝带
    const fluid2d = gl ? null : fluidCanvas.getContext('2d');

    const makeProgram = (fs: string) => {
      if (!gl) return null;
      const compile = (type: number, src: string) => {
        const sh = gl!.createShader(type)!;
        gl!.shaderSource(sh, src);
        gl!.compileShader(sh);
        return sh;
      };
      const p = gl.createProgram();
      gl.attachShader(p, compile(gl.VERTEX_SHADER, VS));
      gl.attachShader(p, compile(gl.FRAGMENT_SHADER, fs));
      gl.bindAttribLocation(p, 0, 'aPos');
      gl.linkProgram(p);
      if (!gl.getProgramParameter(p, gl.LINK_STATUS)) return null;
      return p;
    };

    const makeFbo = (fw: number, fh: number): Fbo | null => {
      if (!gl) return null;
      const tex = gl.createTexture();
      gl.bindTexture(gl.TEXTURE_2D, tex);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, fw, fh, 0, gl.RGBA, gl.UNSIGNED_BYTE, null);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      const fbo = gl.createFramebuffer();
      gl.bindFramebuffer(gl.FRAMEBUFFER, fbo);
      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, tex, 0);
      gl.clearColor(0.5, 0.5, 0.5, 1);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      return { tex: tex!, fbo: fbo! };
    };

    const hex = (v: string): [number, number, number] => [
      parseInt(v.slice(1, 3), 16) / 255,
      parseInt(v.slice(3, 5), 16) / 255,
      parseInt(v.slice(5, 7), 16) / 255,
    ];

    let fluidReady = false;

    if (gl) {
      splat = makeProgram(SPLAT_FS);
      render = makeProgram(RENDER_FS);
      if (!splat || !render) {
        gl = null;
      } else {
        const quad = gl.createBuffer();
        gl.bindBuffer(gl.ARRAY_BUFFER, quad);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
        gl.enableVertexAttribArray(0);
        gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
        const loc = (p: WebGLProgram, names: string[]) => {
          const m: Record<string, WebGLUniformLocation | null> = {};
          for (const n of names) m[n] = gl!.getUniformLocation(p, n);
          return m;
        };
        su = loc(splat, ['uPrev', 'uMouse', 'uVel', 'uRadius', 'uStrength', 'uDecay', 'uAspect']);
        ru = loc(render, [
          'uFlow', 'uRes', 'uTime', 'uAspect', 'uLight',
          'uC1', 'uC2', 'uC3', 'uC4', 'uC5', 'uG1', 'uG2', 'uG3',
        ]);
      }
    }

    const sizeSim = () => {
      if (!gl) return;
      simW = Math.max(1, Math.round(w / 2));
      simH = Math.max(1, Math.round(h / 2));
      simA = makeFbo(simW, simH);
      simB = makeFbo(simW, simH);
    };

    /** 官网流体层参数（type:"fluid" 全套取值） */
    const drawFluidGL = (t: number) => {
      if (!gl || !splat || !render || !simA || !simB) return;
      // 1) 鼠标速度刷进流场（衰减恒定作用，静置时流场慢慢归零）
      gl.useProgram(splat);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, simA.tex);
      gl.uniform1i(su.uPrev!, 0);
      gl.uniform2f(su.uMouse!, smx, smy);
      gl.uniform2f(su.uVel!, svx, svy);
      gl.uniform1f(su.uRadius!, 0.09);
      gl.uniform1f(su.uStrength!, pointerIn && visible ? 1.8 : 0);
      gl.uniform1f(su.uDecay!, 0.925);
      gl.uniform1f(su.uAspect!, w / h);
      gl.bindFramebuffer(gl.FRAMEBUFFER, simB.fbo);
      gl.viewport(0, 0, simW, simH);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      [simA, simB] = [simB, simA];

      // 2) 渲染到屏幕
      gl.useProgram(render);
      gl.activeTexture(gl.TEXTURE0);
      gl.bindTexture(gl.TEXTURE_2D, simA.tex);
      gl.uniform1i(ru.uFlow!, 0);
      gl.uniform2f(ru.uRes!, fluidCanvas!.width, fluidCanvas!.height);
      gl.uniform1f(ru.uTime!, t);
      gl.uniform1f(ru.uAspect!, w / h);
      // 光晕平滑追踪鼠标当前位置；鼠标离开首屏后缓缓漂回默认位
      gl.uniform2f(ru.uLight!, lx, ly);
      const pal = [
        ['#000000', 'uC1'], ['#1A3870', 'uC2'], ['#204a7e', 'uC3'],
        ['#eed8aa', 'uC4'], ['#000000', 'uC5'],
      ] as const;
      for (const [hexv, name] of pal) {
        const [r, g2, b] = hex(hexv);
        gl.uniform3f(ru[name]!, r, g2, b);
      }
      const glow = [
        ['#fff7d1', 'uG1'], ['#538dca', 'uG2'], ['#2d448b', 'uG3'],
      ] as const;
      for (const [hexv, name] of glow) {
        const [r, g2, b] = hex(hexv);
        gl.uniform3f(ru[name]!, r, g2, b);
      }
      gl.bindFramebuffer(gl.FRAMEBUFFER, null);
      gl.viewport(0, 0, fluidCanvas!.width, fluidCanvas!.height);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    };

    /* ---- 2D 回退：无 WebGL 时在流体画布上画丝带 ---- */
    const ribbons = [
      { c: '224, 238, 255', a: 0.16, rx: 0.78, ry: 0.2, x: 0.42, y: 0.24, ang: -0.5, da: 0.1, dx: 0.05, dy: 0.03, sp: 0.42, ph: 0 },
      { c: '96, 140, 255', a: 0.4, rx: 0.85, ry: 0.26, x: 0.5, y: 0.42, ang: -0.32, da: 0.08, dx: 0.04, dy: 0.05, sp: 0.36, ph: 2.1 },
      { c: '64, 106, 255', a: 0.34, rx: 0.95, ry: 0.34, x: 0.62, y: 0.3, ang: -0.75, da: 0.06, dx: 0.05, dy: 0.04, sp: 0.3, ph: 4.2 },
      { c: '150, 186, 255', a: 0.2, rx: 0.6, ry: 0.22, x: 0.78, y: 0.62, ang: -0.15, da: 0.09, dx: 0.03, dy: 0.06, sp: 0.4, ph: 1.2 },
      { c: '205, 224, 255', a: 0.1, rx: 0.45, ry: 0.16, x: 0.18, y: 0.55, ang: -0.55, da: 0.08, dx: 0.04, dy: 0.03, sp: 0.45, ph: 5.3 },
    ];

    const drawFluid2d = (t: number) => {
      if (!fluid2d || w === 0) return;
      const base = fluid2d.createLinearGradient(0, 0, 0, h);
      base.addColorStop(0, '#1b2f63');
      base.addColorStop(0.42, '#12204a');
      base.addColorStop(0.78, '#0a0a0a');
      fluid2d.globalCompositeOperation = 'source-over';
      fluid2d.fillStyle = base;
      fluid2d.fillRect(0, 0, w, h);
      const R = Math.max(w, h * 1.15);
      fluid2d.globalCompositeOperation = 'screen';
      for (const rb of ribbons) {
        const cx = (rb.x + rb.dx * Math.sin(t * rb.sp + rb.ph)) * w;
        const cy = (rb.y + rb.dy * Math.cos(t * rb.sp * 0.9 + rb.ph)) * h;
        const angle = rb.ang + rb.da * Math.sin(t * rb.sp * 0.7 + rb.ph * 1.3);
        const rad = rb.rx * R;
        fluid2d.save();
        fluid2d.translate(cx, cy);
        fluid2d.rotate(angle);
        fluid2d.scale(1, Math.max(rb.ry, 0.05));
        const g = fluid2d.createRadialGradient(0, 0, 0, 0, 0, rad);
        g.addColorStop(0, `rgba(${rb.c}, ${rb.a})`);
        g.addColorStop(0.55, `rgba(${rb.c}, ${rb.a * 0.45})`);
        g.addColorStop(1, 'rgba(0, 0, 0, 0)');
        fluid2d.fillStyle = g;
        fluid2d.beginPath();
        fluid2d.arc(0, 0, rad, 0, Math.PI * 2);
        fluid2d.fill();
        fluid2d.restore();
      }
      fluid2d.globalCompositeOperation = 'source-over';
      const fade = fluid2d.createLinearGradient(0, h * 0.7, 0, h);
      fade.addColorStop(0, 'rgba(10, 10, 10, 0)');
      fade.addColorStop(1, 'rgba(10, 10, 10, 1)');
      fluid2d.fillStyle = fade;
      fluid2d.fillRect(0, 0, w, h);
      const side = fluid2d.createLinearGradient(0, 0, w * 0.5, 0);
      side.addColorStop(0, 'rgba(8, 10, 18, 0.38)');
      side.addColorStop(1, 'rgba(8, 10, 18, 0)');
      fluid2d.fillStyle = side;
      fluid2d.fillRect(0, 0, w, h);
    };

    /* ---- 尺寸与主循环 ---- */
    const resize = () => {
      const rect = heroSection.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      // 柔焦渐变 + 细点阵：DPR 上限 1.5（官方 fluid 层同款上限）
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      fluidCanvas.width = Math.max(1, Math.round(w * dpr));
      fluidCanvas.height = Math.max(1, Math.round(h * dpr));
      gridCanvas.width = fluidCanvas.width;
      gridCanvas.height = fluidCanvas.height;
      if (gl) {
        gl.viewport(0, 0, fluidCanvas.width, fluidCanvas.height);
        sizeSim();
      }
      if (fluid2d) fluid2d.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (ctx) ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initGrid();
      initParticles();
    };

    const renderFrame = (tRaw: number) => {
      // 光晕平滑追踪鼠标；离开后漂回默认位 (0.89, 0.46)
      const hx = pointerIn ? mx : 0.89;
      const hy = pointerIn ? my : 0.46;
      lx += (hx - lx) * 0.075;
      ly += (hy - ly) * 0.075;
      if (gl) drawFluidGL(tRaw * 0.28);
      else if (fluid2d) drawFluid2d(tRaw);
      drawGridFrame();
      drawParticlesFrame(tRaw);
    };

    resize();
    window.addEventListener('resize', resize);

    new IntersectionObserver((entries) => {
      visible = entries[0]?.isIntersecting ?? true;
    }, { threshold: 0 }).observe(heroSection);

    if (reduced) {
      renderFrame(1);
    } else {
      let raf = 0;
      let last = 0;
      const t0 = performance.now();
      const loop = (now: number) => {
        raf = requestAnimationFrame(loop);
        if (!visible || document.hidden || now - last < 33) return;
        last = now;
        // 官方同款平滑/速度链（mouseSmoothing 0.1 / mouseVelocity 0.2）
        const psx = smx;
        const psy = smy;
        smx += (mx - smx) * 0.1;
        smy += (my - smy) * 0.1;
        svx += ((smx - psx) * 0.5 - svx) * 0.2;
        svy += ((smy - psy) * 0.5 - svy) * 0.2;
        renderFrame((now - t0) / 1000);
      };
      raf = requestAnimationFrame(loop);
      window.addEventListener('pagehide', () => cancelAnimationFrame(raf), { once: true });
    }
  }
</script>
