---
/**
 * Hero 区：对齐 DeepSeek Harness 官网版式 —
 * 左侧 kicker + 大标题 + 两段副文案 + 按钮组，
 * 右侧带 Tab 的终端卡片（交通灯 + 复制按钮）。
 */
import Icon from './Icon.astro';
import Download from './Download.astro';
import { PROJECT, DOWNLOADS, type Dict } from '../i18n/content';
import { CHECKSUM_TARGETS, formatChecksumDemo } from '../lib/checksum-demo';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const term = dict.hero.terminal;

/**
 * 终端演示只使用真实数据：构建时取下载清单里的文件名与 SHA-256，
 * 客户端在 /api/downloads 返回更新后的版本时按同一函数重写，
 * 避免版本更新后仍显示旧版哈希。
 */
const termBlocks = CHECKSUM_TARGETS.map((target) => {
  const artifact = DOWNLOADS.platforms?.[target.platform]?.[target.kind];
  return {
    ...target,
    ...formatChecksumDemo(target.mode, artifact?.name, artifact?.sha256, target.fallbackName),
  };
});
---

<section class="hero">
  <canvas class="hero-canvas" data-hero-canvas aria-hidden="true"></canvas>
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-enter hero-head" style="--enter-y:24px;--enter-blur:10px;animation-duration:0.9s">
        <p class="hero-kicker">{dict.hero.kicker}</p>
        <h1 class="t-hero hero-title">
          {dict.hero.title}
          <br />
          <span class="hero-title-accent">{dict.hero.titleAccent}</span>
        </h1>
      </div>

      <div class="hero-enter hero-lede" style="--enter-y:20px;--enter-blur:8px;animation-delay:0.15s">
        <p class="t-body text-muted">{dict.hero.subtitle}</p>
        <p class="t-body text-muted">{dict.hero.subtitle2}</p>
      </div>

      <div class="hero-enter hero-cta" style="--enter-y:16px;animation-duration:0.7s;animation-delay:0.3s">
        <Download dict={dict} variant="lg" />
        <a class="btn btn-ghost btn-m" href={PROJECT.repo}>
          <Icon name="github" size={16} />
          {dict.hero.ctaSecondary}
        </a>
      </div>

      <div class="hero-enter hero-meta" style="--enter-y:12px;animation-delay:0.42s">
        <span class="hero-version">
          <span class="hero-version-dot"></span>
          {dict.hero.versionLabel}
          <span class="hero-version-num" data-dl-version>{DOWNLOADS.version ?? PROJECT.version}</span>
        </span>
        <ul class="hero-req">
          {dict.hero.requirements.map((r) => (
            <li>{r}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hero-visual hero-enter" style="--enter-y:20px;animation-duration:0.9s;animation-delay:0.4s">
      <div class="term-tabs" role="tablist">
        {term.tabs.map((label, i) => (
          <button
            type="button"
            role="tab"
            class:list={['term-tab', i === 0 && 'is-active']}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-term-tab={i}
          >
            {label}
          </button>
        ))}
      </div>

      <div class="term-card">
        <div class="term-head">
          <div class="term-lights" aria-hidden="true">
            <span class="term-light term-light--red"></span>
            <span class="term-light term-light--amber"></span>
            <span class="term-light term-light--green"></span>
          </div>
          <button type="button" class="term-copy" data-term-copy data-copied={term.copied}>
            <Icon name="copy" size={13} />
            <span data-term-copy-label>{term.copy}</span>
          </button>
        </div>

        <div class="term-body">
          {termBlocks.map((block, i) => (
            <pre
              class:list={['term-pre', i !== 0 && 'is-hidden']}
              data-term-pre={i}
              aria-hidden={i !== 0 ? 'true' : undefined}
              data-term-platform={block.platform}
              data-term-kind={block.kind}
              data-term-mode={block.mode}
              data-term-fallback={block.fallbackName}
            ><span class="term-prompt" data-term-prompt>{block.prompt}</span><span data-term-cmd>{block.cmd}</span><span class="term-out" data-term-out>{block.outText}</span></pre>
          ))}
        </div>
      </div>

      <p class="hero-disclaimer">
        <Icon name="shield" size={13} />
        {dict.hero.disclaimer}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }

  /* 首屏背景：深蓝流体 + 半调点阵（对齐 harness 官网的 canvas 氛围层） */
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* 桌面首屏铺满视口，避免标题下方留大片空带 */
  @media (min-width: 900px) {
    .hero {
      min-height: 100svh;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
    align-items: center;
    padding-top: var(--space-10);
    padding-bottom: var(--space-9);
  }

  @media (min-width: 900px) {
    .hero-inner {
      /* minmax(0,…) 防止终端里的长等宽命令把栅格撑破 */
      grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
      padding-bottom: var(--space-11);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .hero-copy {
      gap: var(--space-7);
    }
  }

  .hero-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .hero-kicker {
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #fff;
    padding-left: 3px;
  }

  @media (min-width: 768px) {
    .hero-kicker {
      font-size: 18px;
    }
  }

  .hero-title {
    letter-spacing: 0.2px;
  }

  /* 官网大标题为纯白，品牌蓝只留给 prompt、链接与小标签 */
  .hero-title-accent {
    color: var(--text);
  }

  .hero-lede {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .hero-version {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .hero-version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(40, 200, 64, 0.8);
  }

  .hero-version-num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
  }

  .hero-req {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--space-4);
  }

  .hero-req li {
    font-size: 13px;
    color: var(--text-faint);
  }

  .hero-req li + li::before {
    content: '·';
    margin-right: var(--space-4);
    color: var(--text-faint);
  }

  /* 窄屏换行时行首不悬挂分隔点 */
  @media (max-width: 640px) {
    .hero-req li + li::before {
      content: none;
    }
  }

  /* 右侧视觉 */
  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* 终端 Tab（贴在卡片上沿） */
  .term-tabs {
    display: flex;
    gap: var(--space-1);
    padding-inline: var(--space-1);
    margin-left: 6px;
  }

  .term-tab {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .term-tab:hover {
    color: var(--text);
  }

  .term-tab.is-active {
    color: var(--text);
    background: rgba(0, 0, 0, 0.2);
    border-color: var(--border-subtle);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .term-card {
    border-radius: var(--radius-media);
    border: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow: hidden;
    margin-top: -13px;
  }

  .term-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .term-lights {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .term-light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }

  .term-light--red {
    background: var(--red);
  }
  .term-light--amber {
    background: var(--amber);
  }
  .term-light--green {
    background: var(--green);
  }

  .term-copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .term-copy:hover {
    color: var(--text);
  }

  .term-body {
    padding: var(--space-5);
    /* 两条命令叠在同一网格单元：高度由最长者决定，切 Tab 不跳动 */
    display: grid;
  }

  .term-pre {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text);
    /* 只在空格处换行。break-all 会把 SHA-256 / 长文件名从中间截开 */
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .term-pre.is-hidden {
    visibility: hidden;
  }

  .term-prompt {
    user-select: none;
    color: var(--brand);
  }

  .term-out {
    color: var(--text-muted);
  }

  .hero-disclaimer {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-faint);
  }
</style>

<script>
  // 终端 Tab 切换：同步命令文本与复制目标
  const tabs = Array.from(document.querySelectorAll('[data-term-tab]'));
  const pres = Array.from(document.querySelectorAll('[data-term-pre]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const idx = tab.getAttribute('data-term-tab');
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      pres.forEach((p) => {
        const hidden = p.getAttribute('data-term-pre') !== idx;
        p.classList.toggle('is-hidden', hidden);
        // visibility:hidden 仍留在无障碍树内，显式标记避免读屏念到未选中的命令
        if (hidden) p.setAttribute('aria-hidden', 'true');
        else p.removeAttribute('aria-hidden');
      });
    });
  });

  // 复制当前可见命令
  const copyBtn = document.querySelector('[data-term-copy]');
  const copyLabel = document.querySelector('[data-term-copy-label]');
  copyBtn?.addEventListener('click', async () => {
    const visible = pres.find((p) => !p.classList.contains('is-hidden'));
    // 只复制命令本身，不含模拟输出
    const text = visible?.querySelector('[data-term-cmd]')?.textContent?.trim() ?? '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      return;
    }
    if (!copyLabel) return;
    const original = copyLabel.textContent;
    copyLabel.textContent = copyBtn.getAttribute('data-copied') ?? 'Copied';
    setTimeout(() => {
      copyLabel.textContent = original;
    }, 1600);
  });

  /**
   * 首屏背景：海军蓝底色 + 缓慢漂移的蓝色光斑（screen 叠加）
   * + 中部半调点阵（overlay，只在亮处显现）+ 底部/左侧渐隐回页面黑。
   * 对齐 harness 官网的全屏 canvas 氛围层；内容均为柔和渐变，
   * 固定按 CSS 像素 1x 渲染，30fps 节流，减少动态效果时只画静帧。
   */
  const backdrop = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  if (backdrop) {
    const ctx = backdrop.getContext('2d');
    const heroSection = backdrop.parentElement;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 触屏没有悬停，官方同款判断：这类设备不驱动交互点阵
    const coarsePointer = window.matchMedia('(hover: none), (pointer: coarse)').matches;

    let w = 0;
    let h = 0;
    let dpr = 1;

    /**
     * 交互点阵网格：物理常量与 harness 官网点阵层一致 —
     * 90px 间距；光标 140px 内斥力 (1-d/140)*3/帧；弹簧回弹 0.05；
     * 阻尼 0.85；相邻点拉伸 ≥20px 断线；靠近光标的点变大变亮。
     */
    interface GridDot {
      rx: number;
      ry: number;
      x: number;
      y: number;
      vx: number;
      vy: number;
    }
    let grid: GridDot[] = [];
    let gCols = 0;
    let gRows = 0;
    let mouseX = NaN;
    let mouseY = NaN;

    const initGrid = () => {
      const gap = 90;
      gCols = Math.ceil(w / gap) + 1;
      gRows = Math.ceil(h / gap) + 1;
      const ox = (w - (gCols - 1) * gap) / 2;
      const oy = (h - (gRows - 1) * gap) / 2;
      grid = [];
      for (let r = 0; r < gRows; r++) {
        for (let c = 0; c < gCols; c++) {
          const rx = ox + gap * c;
          const ry = oy + gap * r;
          grid.push({ rx, ry, x: rx, y: ry, vx: 0, vy: 0 });
        }
      }
    };

    const drawGrid = () => {
      if (!ctx || grid.length === 0) return;
      const hasMouse = !Number.isNaN(mouseX);
      // 丝带以 screen 叠加收尾，点阵/连线走正常合成（官方同款）
      ctx.globalCompositeOperation = 'source-over';

      for (const p of grid) {
        if (hasMouse) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const d = Math.hypot(dx, dy);
          if (d < 140 && d > 0.1) {
            const f = (1 - d / 140) * 3;
            p.vx += (dx / d) * f;
            p.vy += (dy / d) * f;
          }
        }
        p.vx += (p.rx - p.x) * 0.05;
        p.vy += (p.ry - p.y) * 0.05;
        p.vx *= 0.85;
        p.vy *= 0.85;
        p.x += p.vx;
        p.y += p.vy;
      }

      ctx.lineWidth = 0.5;
      // 官网点阵为深底调色（rgba(60,100,160)），本站丝带更亮，改用冷蓝浅色保持对比
      ctx.strokeStyle = 'rgba(174, 198, 246, 0.12)';
      ctx.beginPath();
      const link = (a: GridDot, b: GridDot) => {
        const dx = b.x - a.x;
        const dy = b.y - a.y;
        const d = Math.hypot(dx, dy);
        if (d < 20 || d === 0) return;
        const ux = dx / d;
        const uy = dy / d;
        ctx.moveTo(a.x + 10 * ux, a.y + 10 * uy);
        ctx.lineTo(b.x - 10 * ux, b.y - 10 * uy);
      };
      for (let r = 0; r < gRows; r++) {
        for (let c = 0; c < gCols - 1; c++) link(grid[r * gCols + c], grid[r * gCols + c + 1]);
      }
      for (let c = 0; c < gCols; c++) {
        for (let r = 0; r < gRows - 1; r++) link(grid[r * gCols + c], grid[(r + 1) * gCols + c]);
      }
      ctx.stroke();

      ctx.fillStyle = 'rgb(174, 198, 246)';
      for (const p of grid) {
        let half = 1.8;
        let alpha = 0.28;
        if (hasMouse) {
          const l = Math.max(0, 1 - Math.hypot(p.x - mouseX, p.y - mouseY) / 140);
          half = 1.8 + 2 * l;
          alpha = 0.28 + 0.45 * l;
        }
        ctx.globalAlpha = alpha;
        ctx.fillRect(p.x - half, p.y - half, half * 2, half * 2);
      }
      ctx.globalAlpha = 1;
    };

    const resize = () => {
      if (!heroSection || !ctx) return;
      const rect = heroSection.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      // 内容是柔焦渐变 + 细点阵：DPR 上限 1.5，精度与填充开销的平衡点（与官方 fluid 层一致）
      dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      backdrop.width = Math.max(1, Math.round(w * dpr));
      backdrop.height = Math.max(1, Math.round(h * dpr));
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      initGrid();
    };

    /**
     * 丝带光斑：用「旋转椭圆 + 径向渐变」模拟官网的蓝色流体绸带。
     * screen 叠加让多束丝带提亮交汇处；角度与位置随时间缓慢摆动，
     * 静止截图是绸带构图，盯几秒能看到流动。
     */
    const ribbons = [
      // 亮白丝带：官网左上那道近白高光
      { c: '224, 238, 255', a: 0.16, rx: 0.78, ry: 0.2, x: 0.42, y: 0.24, ang: -0.5, da: 0.1, dx: 0.05, dy: 0.03, sp: 0.42, ph: 0 },
      // 主蓝绸带：横贯中部
      { c: '96, 140, 255', a: 0.4, rx: 0.85, ry: 0.26, x: 0.5, y: 0.42, ang: -0.32, da: 0.08, dx: 0.04, dy: 0.05, sp: 0.36, ph: 2.1 },
      // 深蓝宽绸带：右上向左下
      { c: '64, 106, 255', a: 0.34, rx: 0.95, ry: 0.34, x: 0.62, y: 0.3, ang: -0.75, da: 0.06, dx: 0.05, dy: 0.04, sp: 0.3, ph: 4.2 },
      // 浅蓝丝带：右下
      { c: '150, 186, 255', a: 0.2, rx: 0.6, ry: 0.22, x: 0.78, y: 0.62, ang: -0.15, da: 0.09, dx: 0.03, dy: 0.06, sp: 0.4, ph: 1.2 },
      // 淡青高光：左中
      { c: '205, 224, 255', a: 0.1, rx: 0.45, ry: 0.16, x: 0.18, y: 0.55, ang: -0.55, da: 0.08, dx: 0.04, dy: 0.03, sp: 0.45, ph: 5.3 },
    ];

    const draw = (t: number) => {
      if (!ctx || w === 0) return;
      const base = ctx.createLinearGradient(0, 0, 0, h);
      base.addColorStop(0, '#1b2f63');
      base.addColorStop(0.42, '#12204a');
      base.addColorStop(0.78, '#0a0a0a');
      ctx.globalCompositeOperation = 'source-over';
      ctx.fillStyle = base;
      ctx.fillRect(0, 0, w, h);

      const R = Math.max(w, h * 1.15);
      ctx.globalCompositeOperation = 'screen';
      for (const rb of ribbons) {
        const cx = (rb.x + rb.dx * Math.sin(t * rb.sp + rb.ph)) * w;
        const cy = (rb.y + rb.dy * Math.cos(t * rb.sp * 0.9 + rb.ph)) * h;
        const angle = rb.ang + rb.da * Math.sin(t * rb.sp * 0.7 + rb.ph * 1.3);
        const rad = rb.rx * R;
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(angle);
        ctx.scale(1, Math.max(rb.ry, 0.05));
        const g = ctx.createRadialGradient(0, 0, 0, 0, 0, rad);
        g.addColorStop(0, `rgba(${rb.c}, ${rb.a})`);
        g.addColorStop(0.55, `rgba(${rb.c}, ${rb.a * 0.45})`);
        g.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = g;
        ctx.beginPath();
        ctx.arc(0, 0, rad, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }

      drawGrid();

      ctx.globalCompositeOperation = 'source-over';
      const fade = ctx.createLinearGradient(0, h * 0.7, 0, h);
      fade.addColorStop(0, 'rgba(10, 10, 10, 0)');
      fade.addColorStop(1, 'rgba(10, 10, 10, 1)');
      ctx.fillStyle = fade;
      ctx.fillRect(0, 0, w, h);
      const side = ctx.createLinearGradient(0, 0, w * 0.5, 0);
      side.addColorStop(0, 'rgba(8, 10, 18, 0.38)');
      side.addColorStop(1, 'rgba(8, 10, 18, 0)');
      ctx.fillStyle = side;
      ctx.fillRect(0, 0, w, h);
    };

    resize();
    window.addEventListener('resize', resize);

    // 鼠标驱动交互点阵：只在可悬停设备且未开启减少动态效果时挂监听；
    // 坐标相对首屏，鼠标移出首屏区域后点阵自然回弹归位
    if (!reduced && !coarsePointer) {
      window.addEventListener(
        'mousemove',
        (e) => {
          if (!heroSection) return;
          const rect = heroSection.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          if (x >= 0 && y >= 0 && x <= rect.width && y <= rect.height) {
            mouseX = x;
            mouseY = y;
          } else {
            mouseX = NaN;
            mouseY = NaN;
          }
        },
        { passive: true }
      );
    }

    if (reduced) {
      draw(1.7);
    } else {
      let raf = 0;
      let last = 0;
      const t0 = performance.now();
      const loop = (now: number) => {
        raf = requestAnimationFrame(loop);
        if (document.hidden || now - last < 33) return;
        last = now;
        draw((now - t0) / 1000);
      };
      raf = requestAnimationFrame(loop);
      window.addEventListener('pagehide', () => cancelAnimationFrame(raf), { once: true });
    }
  }
</script>
