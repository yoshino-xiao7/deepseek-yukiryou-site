---
/**
 * Hero 区：对齐 DeepSeek Harness 官网版式 —
 * 左侧 kicker + 大标题 + 两段副文案 + 按钮组，
 * 右侧带 Tab 的终端卡片（交通灯 + 复制按钮）。
 */
import Icon from './Icon.astro';
import Download from './Download.astro';
import { PROJECT, DOWNLOADS, type Dict } from '../i18n/content';
import { CHECKSUM_TARGETS, formatChecksumDemo } from '../lib/checksum-demo';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const term = dict.hero.terminal;

/**
 * 终端演示只使用真实数据：构建时取下载清单里的文件名与 SHA-256，
 * 客户端在 /api/downloads 返回更新后的版本时按同一函数重写，
 * 避免版本更新后仍显示旧版哈希。
 */
const termBlocks = CHECKSUM_TARGETS.map((target) => {
  const artifact = DOWNLOADS.platforms?.[target.platform]?.[target.kind];
  return {
    ...target,
    ...formatChecksumDemo(target.mode, artifact?.name, artifact?.sha256, target.fallbackName),
  };
});
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-copy">
      <div class="hero-enter hero-head" style="--enter-y:24px;--enter-blur:10px;animation-duration:0.9s">
        <p class="hero-kicker">{dict.hero.kicker}</p>
        <h1 class="t-hero hero-title">
          {dict.hero.title}
          <br />
          <span class="hero-title-accent">{dict.hero.titleAccent}</span>
        </h1>
      </div>

      <div class="hero-enter hero-lede" style="--enter-y:20px;--enter-blur:8px;animation-delay:0.15s">
        <p class="t-body text-muted">{dict.hero.subtitle}</p>
        <p class="t-body text-muted">{dict.hero.subtitle2}</p>
      </div>

      <div class="hero-enter hero-cta" style="--enter-y:16px;animation-duration:0.7s;animation-delay:0.3s">
        <Download dict={dict} variant="lg" />
        <a class="btn btn-secondary btn-m" href={PROJECT.repo}>
          <Icon name="github" size={16} />
          {dict.hero.ctaSecondary}
        </a>
      </div>

      <div class="hero-enter hero-meta" style="--enter-y:12px;animation-delay:0.42s">
        <span class="hero-version">
          <span class="hero-version-dot"></span>
          {dict.hero.versionLabel}
          <span class="hero-version-num" data-dl-version>{DOWNLOADS.version ?? PROJECT.version}</span>
        </span>
        <ul class="hero-req">
          {dict.hero.requirements.map((r) => (
            <li>{r}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="hero-visual hero-enter" style="--enter-y:20px;animation-duration:0.9s;animation-delay:0.4s">
      <div class="term-tabs" role="tablist">
        {term.tabs.map((label, i) => (
          <button
            type="button"
            role="tab"
            class:list={['term-tab', i === 0 && 'is-active']}
            aria-selected={i === 0 ? 'true' : 'false'}
            data-term-tab={i}
          >
            {label}
          </button>
        ))}
      </div>

      <div class="term-card">
        <div class="term-head">
          <div class="term-lights" aria-hidden="true">
            <span class="term-light term-light--red"></span>
            <span class="term-light term-light--amber"></span>
            <span class="term-light term-light--green"></span>
          </div>
          <button type="button" class="term-copy" data-term-copy data-copied={term.copied}>
            <Icon name="copy" size={13} />
            <span data-term-copy-label>{term.copy}</span>
          </button>
        </div>

        <div class="term-body">
          {termBlocks.map((block, i) => (
            <pre
              class:list={['term-pre', i !== 0 && 'is-hidden']}
              data-term-pre={i}
              aria-hidden={i !== 0 ? 'true' : undefined}
              data-term-platform={block.platform}
              data-term-kind={block.kind}
              data-term-mode={block.mode}
              data-term-fallback={block.fallbackName}
            ><span class="term-prompt" data-term-prompt>{block.prompt}</span><span data-term-cmd>{block.cmd}</span><span class="term-out" data-term-out>{block.outText}</span></pre>
          ))}
        </div>
      </div>

      <figure class="shot-frame">
        <img
          class="shot-img"
          src="/app-screenshot.png"
          alt={dict.hero.shotAlt}
          width="1400"
          height="789"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <p class="hero-disclaimer">
        <Icon name="shield" size={13} />
        {dict.hero.disclaimer}
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  /* 桌面首屏铺满视口，避免标题下方留大片空带 */
  @media (min-width: 900px) {
    .hero {
      min-height: 100svh;
    }
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-9);
    align-items: center;
    padding-top: var(--space-10);
    padding-bottom: var(--space-9);
  }

  @media (min-width: 900px) {
    .hero-inner {
      /* minmax(0,…) 防止终端里的长等宽命令把栅格撑破 */
      grid-template-columns: minmax(0, 56fr) minmax(0, 44fr);
      padding-bottom: var(--space-11);
    }
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .hero-copy {
      gap: var(--space-7);
    }
  }

  .hero-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .hero-kicker {
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.01em;
    color: #fff;
    padding-left: 3px;
  }

  @media (min-width: 768px) {
    .hero-kicker {
      font-size: 18px;
    }
  }

  .hero-title {
    letter-spacing: 0.2px;
  }

  /* 官网大标题为纯白，品牌蓝只留给 prompt、链接与小标签 */
  .hero-title-accent {
    color: var(--text);
  }

  .hero-lede {
    max-width: 580px;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }

  .hero-version {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .hero-version-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--green);
    box-shadow: 0 0 8px rgba(40, 200, 64, 0.8);
  }

  .hero-version-num {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-secondary);
  }

  .hero-req {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px var(--space-4);
  }

  .hero-req li {
    font-size: 13px;
    color: var(--text-faint);
  }

  .hero-req li + li::before {
    content: '·';
    margin-right: var(--space-4);
    color: var(--text-faint);
  }

  /* 右侧视觉 */
  .hero-visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  /* 终端 Tab（贴在卡片上沿） */
  .term-tabs {
    display: flex;
    gap: var(--space-1);
    padding-inline: var(--space-1);
    margin-left: 6px;
  }

  .term-tab {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
    border-bottom: 0;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .term-tab:hover {
    color: var(--text);
  }

  .term-tab.is-active {
    color: var(--text);
    background: rgba(0, 0, 0, 0.2);
    border-color: var(--border-subtle);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .term-card {
    border-radius: var(--radius-media);
    border: 1px solid var(--border-subtle);
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    overflow: hidden;
    margin-top: -13px;
  }

  .term-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .term-lights {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .term-light {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: block;
  }

  .term-light--red {
    background: var(--red);
  }
  .term-light--amber {
    background: var(--amber);
  }
  .term-light--green {
    background: var(--green);
  }

  .term-copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .term-copy:hover {
    color: var(--text);
  }

  .term-body {
    padding: var(--space-5);
    /* 两条命令叠在同一网格单元：高度由最长者决定，切 Tab 不跳动 */
    display: grid;
  }

  .term-pre {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--text);
    /* 只在空格处换行。break-all 会把 SHA-256 / 长文件名从中间截开 */
    white-space: pre-wrap;
    overflow-wrap: break-word;
    word-break: normal;
  }

  .term-pre.is-hidden {
    visibility: hidden;
  }

  .term-prompt {
    user-select: none;
    color: var(--brand);
  }

  .term-out {
    color: var(--text-muted);
  }

  /* 应用截图 */
  .shot-frame {
    margin: var(--space-2) 0 0;
    border-radius: var(--radius-media);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 24px 64px -24px rgba(0, 0, 0, 0.8),
      0 0 80px -24px rgba(var(--rgb-brand), 0.24);
  }

  .shot-img {
    width: 100%;
    height: auto;
  }

  .hero-disclaimer {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text-faint);
  }
</style>

<script>
  // 终端 Tab 切换：同步命令文本与复制目标
  const tabs = Array.from(document.querySelectorAll('[data-term-tab]'));
  const pres = Array.from(document.querySelectorAll('[data-term-pre]'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const idx = tab.getAttribute('data-term-tab');
      tabs.forEach((t) => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      pres.forEach((p) => {
        const hidden = p.getAttribute('data-term-pre') !== idx;
        p.classList.toggle('is-hidden', hidden);
        // visibility:hidden 仍留在无障碍树内，显式标记避免读屏念到未选中的命令
        if (hidden) p.setAttribute('aria-hidden', 'true');
        else p.removeAttribute('aria-hidden');
      });
    });
  });

  // 复制当前可见命令
  const copyBtn = document.querySelector('[data-term-copy]');
  const copyLabel = document.querySelector('[data-term-copy-label]');
  copyBtn?.addEventListener('click', async () => {
    const visible = pres.find((p) => !p.classList.contains('is-hidden'));
    // 只复制命令本身，不含模拟输出
    const text = visible?.querySelector('[data-term-cmd]')?.textContent?.trim() ?? '';
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      return;
    }
    if (!copyLabel) return;
    const original = copyLabel.textContent;
    copyLabel.textContent = copyBtn.getAttribute('data-copied') ?? 'Copied';
    setTimeout(() => {
      copyLabel.textContent = original;
    }, 1600);
  });
</script>
