---
/**
 * 安装：三步 + 系统要求 + 校验说明
 */
import Icon from './Icon.astro';
import Download from './Download.astro';
import { PROJECT, DOWNLOADS, type Dict } from '../i18n/content';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="section" id="install">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow"><span>{dict.install.eyebrow}</span></span>
      <h2 class="t-h1 section-title">{dict.install.title}</h2>
      <p class="t-body section-sub">{dict.install.subtitle}</p>
    </div>

    <div class="install-grid">
      <ol class="install-steps reveal">
        {dict.install.steps.map((step, i) => (
          <li class="install-step">
            <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="t-subtitle step-title">{step.title}</h3>
              <p class="t-body text-muted step-desc">{step.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <aside class="install-side reveal">
        <div class="side-card">
          <h3 class="side-title">
            <Icon name="cpu" size={16} strokeWidth={1.6} />
            {dict.install.requirementsTitle}
          </h3>
          <ul class="side-list">
            {dict.install.requirements.map((r) => (
              <li>
                <Icon name="check" size={13} />
                <span class="t-caption">{r}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="side-card">
          <h3 class="side-title">
            <Icon name="file" size={16} strokeWidth={1.6} />
            {dict.install.fileNameTitle}
          </h3>

          <p class="t-mono-label side-label">macOS</p>
          <code
            class="pkg-name"
            data-dl-file
            data-platform="darwin-arm64"
            data-kind="primary"
          >{DOWNLOADS.platforms?.['darwin-arm64']?.primary?.name ?? PROJECT.dmgName}</code>

          <p class="t-mono-label side-label">Windows</p>
          <code
            class="pkg-name"
            data-dl-file
            data-platform="win32-x64"
            data-kind="primary"
          >{DOWNLOADS.platforms?.['win32-x64']?.primary?.name ?? PROJECT.winExeName}</code>

          <p class="t-caption side-note">{dict.install.fileNameDesc}</p>
          <p class="t-caption side-note side-note--strong">
            <Icon name="shield" size={13} />
            <span>{dict.install.shaNote}</span>
          </p>
        </div>

        <Download dict={dict} variant="block" />
      </aside>
    </div>
  </div>
</section>

<style>
  .install-grid {
    display: grid;
    gap: var(--space-7);
    align-items: start;
    margin-top: var(--space-8);
  }

  @media (min-width: 960px) {
    .install-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: var(--space-8);
    }
  }

  .install-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .install-step {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    position: relative;
    padding-bottom: var(--space-6);
  }

  .install-step:last-child {
    padding-bottom: 0;
  }

  .install-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 17px;
    top: 40px;
    bottom: 8px;
    width: 1px;
    background: var(--border-divider);
  }

  .step-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 12px;
    z-index: 1;
  }

  .step-title {
    margin-bottom: var(--space-2);
  }

  .step-desc {
    line-height: 1.7;
  }

  .install-side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .side-card {
    background: var(--surface-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-media);
    padding: var(--space-5);
  }

  .side-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    margin-bottom: var(--space-4);
  }

  .side-title :global(svg) {
    color: var(--brand);
  }

  .side-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .side-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-muted);
  }

  .side-list :global(svg) {
    color: var(--green);
    flex-shrink: 0;
  }

  .side-label {
    display: block;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .side-label:not(:first-of-type) {
    margin-top: var(--space-4);
  }

  .pkg-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: var(--brand);
    background: rgba(var(--rgb-brand), 0.1);
    border: 1px solid rgba(var(--rgb-brand), 0.28);
    border-radius: var(--radius-sm);
    padding: var(--space-3);
    word-break: break-all;
  }

  .side-note {
    color: var(--text-faint);
    line-height: 1.65;
    margin-top: var(--space-4);
  }

  .side-note--strong {
    display: flex;
    gap: 7px;
    align-items: flex-start;
    color: var(--text-muted);
  }

  .side-note--strong :global(svg) {
    color: var(--green);
    flex-shrink: 0;
    margin-top: 3px;
  }
</style>
