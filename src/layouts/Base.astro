---
/**
 * 基础布局：负责 <head> 中的全部 SEO 元信息、共享 Header/Footer。
 * 通过 Astro.url 自动生成 canonical 与 hreflang 备用链接。
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { PROJECT, DOWNLOADS, type Dict, type Lang } from '../i18n/content';
import '../styles/global.css';

interface Props {
  lang: Lang;
  dict: Dict;
  /** 当前页面的附加 JSON-LD（已序列化为对象） */
  jsonLd?: object[];
}

const { lang, dict, jsonLd = [] } = Astro.props;

const SITE = 'https://deepseek.yukiryou.icu';
const path = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '') + '/';
const canonical = `${SITE}${path}`;
const ogImage = `${SITE}/og-cover.png`;

/** 中英文对应路径：中文在 /，英文在 /en/ */
const alternateUrl = (l: Lang) =>
  `${SITE}${l === 'zh-CN' ? '/' : '/en/'}`;

const pageTitle = dict.meta.title;
const description = dict.meta.description;

const softwareJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'DeepSeek YukiRyou',
  alternateName: 'DeepSeek Harness Desktop for macOS & Windows',
  description: dict.meta.description,
  url: SITE,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS 14+ (Apple Silicon), Windows 11 x64',
  softwareVersion: PROJECT.version,
  license: 'https://opensource.org/licenses/MIT',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  sameAs: [PROJECT.repo],
  publisher: {
    '@type': 'Organization',
    name: 'YukiRyou',
    url: 'https://github.com/yoshino-xiao7',
  },
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DeepSeek YukiRyou',
  url: SITE,
  inLanguage: lang,
};

const allJsonLd = [websiteJsonLd, softwareJsonLd, ...jsonLd];
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- 站点验证与主题 -->
    <meta name="google-site-verification" content="eKEGiYR_MejlPuEzN7ULsbX9tjHjv6NPRrdLNhci1Ow" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="color-scheme" content="dark" />

    <!-- canonical 与 hreflang -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={alternateUrl('zh-CN')} />
    <link rel="alternate" hreflang="en" href={alternateUrl('en')} />
    <link rel="alternate" hreflang="x-default" href={alternateUrl('zh-CN')} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DeepSeek YukiRyou" />
    <meta property="og:title" content={dict.meta.ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh-CN' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh-CN' ? 'en_US' : 'zh_CN'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={dict.meta.ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- 关键字体预载（自托管，避免首屏标题闪动） -->
    <link rel="preload" href="/fonts/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/montserrat-500.woff2" as="font" type="font/woff2" crossorigin />

    <!-- 图标 -->
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/app-icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/app-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- 结构化数据 -->
    {allJsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}

    <!-- 下载配置：构建时生成，随页面内联，首屏即为正确直链（无需跨域 fetch） -->
    <script is:inline type="application/json" id="downloads-config" set:html={JSON.stringify(DOWNLOADS)}></script>
  </head>
  <body>
    <Header lang={lang} dict={dict} />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} dict={dict} />

    <script>
      // 滚动显现（尊重系统减少动态效果设置）
      const els = document.querySelectorAll('.reveal');
      if (els.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>

    <!-- 下载中心：读取国内 OSS 清单并绑定四个直链，失败回退 GitHub 最新发行页 -->
    <script src="../scripts/downloads.ts"></script>
  </body>
</html>
