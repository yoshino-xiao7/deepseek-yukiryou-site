---
/**
 * 简体中文首页（默认语言，挂在 / 下）
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Concept from '../components/Concept.astro';
import Approach from '../components/Approach.astro';
import Features from '../components/Features.astro';
import Why from '../components/Why.astro';
import Install from '../components/Install.astro';
import Security from '../components/Security.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { t, faqJsonLd } from '../i18n/content';

const lang = 'zh-CN' as const;
const dict = t[lang];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqJsonLd(lang).map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<Base lang={lang} dict={dict} jsonLd={[faqLd]}>
  <Hero dict={dict} />
  <Concept dict={dict} />
  <Approach dict={dict} />
  <Features dict={dict} />
  <Why dict={dict} />
  <Install dict={dict} />
  <Security dict={dict} />
  <Faq dict={dict} />
  <Cta dict={dict} />
</Base>
